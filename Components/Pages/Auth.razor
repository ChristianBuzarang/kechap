@page "/auth"
@inject NavigationManager Nav

<PageTitle>Account - Kechap</PageTitle>

<div class="flex min-h-[70vh] items-center justify-center px-6 pt-4 pb-12">
    <div class="flex w-full max-w-[950px] flex-col overflow-hidden rounded-3xl border border-line bg-card shadow-xl transition-colors duration-300 dark:bg-[#1e2812] @(isLogin ? "md:flex-row-reverse" : "md:flex-row")">

        <div class="flex flex-1 flex-col justify-center p-12 max-sm:p-8">
            @if (isLogin)
            {
                <h1 class="mb-2 font-display text-[2rem] font-bold">Welcome Back</h1>
                <p class="mb-8 text-sm opacity-75">Enter your details to access your focus sessions.</p>

                <form @onsubmit="Submit" @onsubmit:preventDefault>
                    <input type="email" placeholder="Email Address" required class="@InputClass" />
                    <input type="password" placeholder="Password" required class="@InputClass" />
                    <button type="submit" class="@SubmitClass">Sign In</button>
                </form>

                <p class="mt-6 text-center text-sm opacity-80">
                    Don't have an account?
                    <button type="button" @onclick="ToggleMode" class="@LinkClass">Sign Up</button>
                </p>
            }
            else
            {
                <h1 class="mb-2 font-display text-[2rem] font-bold">Create Account</h1>
                <p class="mb-8 text-sm opacity-75">Start tracking your productivity with Kechap today.</p>

                <form @onsubmit="Submit" @onsubmit:preventDefault>
                    <input type="text" placeholder="Full Name" required class="@InputClass" />
                    <input type="email" placeholder="Email Address" required class="@InputClass" />
                    <input type="password" placeholder="Create Password" required class="@InputClass" />
                    <button type="submit" class="@SubmitClass">Sign Up</button>
                </form>

                <p class="mt-6 text-center text-sm opacity-80">
                    Already a member?
                    <button type="button" @onclick="ToggleMode" class="@LinkClass">Sign In</button>
                </p>
            }
        </div>

        <div class="flex flex-1 flex-col items-center justify-center bg-linear-to-br from-moss to-forest p-12 text-center text-ink max-sm:p-8 dark:from-[#780001] dark:to-[#4a0000]">
            <img src="images/tomatoes.png" alt="Three hand-drawn tomatoes"
                 class="mb-8 w-full max-w-[260px] drop-shadow-lg max-sm:max-w-[200px]" />
            <h2 class="mb-4 text-2xl font-bold">Master Your Focus</h2>
            <p class="max-w-[280px] text-[0.95rem] opacity-90">
                Track deep work sessions, build better daily habits, and reach your goals effortlessly.
            </p>
        </div>
    </div>
</div>

@code {
    private const string InputClass = "mb-5 w-full rounded-[10px] border border-line bg-field px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink/50 transition focus:border-lime focus:ring-[3px] focus:ring-lime/30 focus:outline-none dark:bg-[#2d3b1e]";
    private const string SubmitClass = "mt-4 w-full cursor-pointer rounded-[10px] bg-btn py-3.5 font-semibold text-btn-ink transition hover:-translate-y-0.5 hover:opacity-95 dark:bg-[#ff6b6b] dark:text-[#111]";
    private const string LinkClass = "cursor-pointer font-semibold text-lime hover:underline dark:text-[#ff6b6b]";

    private bool isLogin = true;

    private void ToggleMode() => isLogin = !isLogin;

    // No database yet: signing in or up just goes to the timer.
    private void Submit() => Nav.NavigateTo("/");
}