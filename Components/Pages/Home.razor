@page "/"
@using kechap.Services
@inject PomodoroTimerService Pomodoro
@implements IDisposable

<PageTitle>@Pomodoro.FormattedTime - Kechap</PageTitle>

<div class="mx-auto flex max-w-[520px] flex-col items-center px-4 pt-4 pb-12">

    <section class="w-full rounded-2xl border border-line bg-card px-8 py-10 text-center shadow-xl transition-colors duration-300">
        <div class="mb-8 flex justify-center gap-2.5">
            @foreach (var tab in Tabs)
            {
                <button type="button" @onclick="() => Pomodoro.SetMode(tab.Mode)"
                        class="cursor-pointer rounded-md px-4 py-2 text-[0.95rem] font-semibold transition-all hover:bg-tab hover:opacity-100 @(Pomodoro.Mode == tab.Mode ? "bg-tab opacity-100" : "opacity-75")">
                    @tab.Label
                </button>
            }
        </div>

        <div class="mb-10 font-display text-[7rem] leading-none font-bold tracking-[-3px] max-sm:text-[4.5rem]">
            @Pomodoro.FormattedTime
        </div>

        <button type="button" @onclick="Pomodoro.Toggle"
                class="cursor-pointer rounded-lg bg-btn px-16 py-3.5 font-display text-[1.35rem] font-bold tracking-widest text-btn-ink shadow-lg transition hover:-translate-y-0.5 hover:opacity-95">
            @(Pomodoro.IsRunning ? "PAUSE" : "START")
        </button>
    </section>

    <p class="mt-7 text-center font-medium">
        #@SessionNumber<br />@StatusText
    </p>

    <section class="mt-8 w-full">
        <div class="mb-4 flex items-center justify-between border-b-2 border-line pb-2 text-lg font-semibold">
            <span>Tasks</span>
            <button type="button" @onclick="ClearFinished" title="Clear finished tasks"
                    class="flex size-[30px] cursor-pointer items-center justify-center rounded-md bg-black/[0.08]">
                ⋮
            </button>
        </div>

        @foreach (var task in tasks)
        {
            <div class="mb-2 flex items-center gap-3 rounded-lg border border-line bg-card px-4 py-3">
                <input type="checkbox" checked="@task.Done" @onchange="() => ToggleTask(task)"
                       class="size-4 cursor-pointer accent-accent" />
                <span class="flex-1 @(task.Done ? "line-through opacity-60" : "")">@task.Title</span>
                <button type="button" @onclick="() => RemoveTask(task)" aria-label="Remove task"
                        class="cursor-pointer opacity-60 hover:opacity-100">✕</button>
            </div>
        }

        @if (isAddingTask)
        {
            <div class="flex gap-2">
                <input @ref="taskInput" @bind="newTaskTitle" @bind:event="oninput" @onkeyup="HandleKeyUp"
                       placeholder="Task name..."
                       class="min-w-0 flex-1 rounded-lg border border-line bg-field px-3 py-2 text-ink placeholder:text-ink/50 focus:ring-2 focus:ring-accent/40 focus:outline-none" />
                <button type="button" @onclick="ConfirmAddTask"
                        class="cursor-pointer rounded-lg bg-forest px-4 py-2 font-semibold text-cream hover:opacity-90 dark:bg-btn dark:text-btn-ink">Add</button>
                <button type="button" @onclick="CancelAddTask"
                        class="cursor-pointer rounded-lg px-3 py-2 font-semibold hover:bg-tab">Cancel</button>
            </div>
        }
        else
        {
            <button type="button" @onclick="StartAddTask"
                    class="w-full cursor-pointer rounded-lg border-2 border-dashed border-line bg-black/[0.03] p-5 text-center text-[0.95rem] font-medium transition-colors hover:bg-black/[0.07]">
                + Add Task
            </button>
        }
    </section>
</div>

@code {
    private static readonly (TimerMode Mode, string Label)[] Tabs =
    {
        (TimerMode.Pomodoro, "Pomodoro"),
        (TimerMode.ShortBreak, "Short Break"),
        (TimerMode.LongBreak, "Long Break")
    };

    private readonly List<TaskItem> tasks = new();
    private bool isAddingTask;
    private bool focusTaskInput;
    private string newTaskTitle = "";
    private ElementReference taskInput;

    private int SessionNumber => Pomodoro.Mode == TimerMode.Pomodoro
        ? Pomodoro.CompletedPomodoros + 1
        : Math.Max(1, Pomodoro.CompletedPomodoros);

    private string StatusText => Pomodoro.Mode switch
    {
        TimerMode.ShortBreak => "Time for a short break!",
        TimerMode.LongBreak => "Time for a long break!",
        _ => "Time to focus!"
    };

    protected override void OnInitialized() => Pomodoro.Changed += OnTimerChanged;

    private void OnTimerChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusTaskInput)
        {
            focusTaskInput = false;
            await taskInput.FocusAsync();
        }
    }

    private void ToggleTask(TaskItem task) => task.Done = !task.Done;
    private void RemoveTask(TaskItem task) => tasks.Remove(task);
    private void ClearFinished() => tasks.RemoveAll(t => t.Done);

    private void StartAddTask()
    {
        isAddingTask = true;
        focusTaskInput = true;
        newTaskTitle = "";
    }

    private void ConfirmAddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTaskTitle))
            tasks.Add(new TaskItem { Title = newTaskTitle.Trim() });

        isAddingTask = false;
        newTaskTitle = "";
    }

    private void CancelAddTask()
    {
        isAddingTask = false;
        newTaskTitle = "";
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ConfirmAddTask();
        else if (e.Key == "Escape") CancelAddTask();
    }

    public void Dispose() => Pomodoro.Changed -= OnTimerChanged;

    private sealed class TaskItem
    {
        public string Title { get; set; } = "";
        public bool Done { get; set; }
    }
}