@page "/report"
@using kechap.Services
@inject PomodoroTimerService Pomodoro
@implements IDisposable

<PageTitle>Report - Kechap</PageTitle>

<div class="mx-auto my-6 max-w-[750px] px-4 pb-12">
    <h1 class="mb-6 font-display text-3xl font-bold">Focus Report</h1>

    <div class="mb-8 grid grid-cols-3 gap-4 max-sm:grid-cols-1">
        <div class="rounded-xl border border-line bg-card px-4 py-6 text-center shadow-lg transition-colors duration-300">
            <div class="mb-1 font-display text-[2rem] font-bold">@((Pomodoro.FocusedMinutes / 60.0).ToString("0.0"))</div>
            <div class="text-sm font-medium opacity-80">Hours Focused Today</div>
        </div>
        <div class="rounded-xl border border-line bg-card px-4 py-6 text-center shadow-lg transition-colors duration-300">
            <div class="mb-1 font-display text-[2rem] font-bold">@Pomodoro.CompletedPomodoros</div>
            <div class="text-sm font-medium opacity-80">Completed Sessions</div>
        </div>
        <div class="rounded-xl border border-line bg-card px-4 py-6 text-center shadow-lg transition-colors duration-300">
            <div class="mb-1 font-display text-[2rem] font-bold">@SessionsUntilLongBreak</div>
            <div class="text-sm font-medium opacity-80">Sessions Until Long Break</div>
        </div>
    </div>

    <div class="rounded-xl border border-line bg-card p-8 shadow-lg transition-colors duration-300">
        <h2 class="mb-4 font-display text-xl font-semibold">Weekly Focus Time (Hours)</h2>

        <div class="flex h-[180px] items-end justify-around border-b-2 border-line pt-5">
            @foreach (var d in week)
            {
                <div class="w-9 rounded-t-md bg-accent opacity-75 transition-all" style="height:@(d.Percent)%"></div>
            }
        </div>
        <div class="flex justify-around pt-2.5 text-[0.85rem] font-medium opacity-80">
            @foreach (var d in week)
            {
                <span class="w-9 text-center">@d.Day</span>
            }
        </div>
    </div>
</div>

@code {
    // Sample data until there is a database.
    private readonly (string Day, int Percent)[] week =
    {
        ("Mon", 60), ("Tue", 85), ("Wed", 40), ("Thu", 95), ("Fri", 70), ("Sat", 50), ("Sun", 30)
    };

    private int SessionsUntilLongBreak =>
        PomodoroTimerService.SessionsBeforeLongBreak
        - (Pomodoro.CompletedPomodoros % PomodoroTimerService.SessionsBeforeLongBreak);

    protected override void OnInitialized() => Pomodoro.Changed += OnTimerChanged;

    private void OnTimerChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Pomodoro.Changed -= OnTimerChanged;
}