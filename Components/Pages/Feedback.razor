@page "/feedback"
@using System.ComponentModel.DataAnnotations
@using kechap.Models
@using kechap.Services
@inject FeedbackService FeedbackStore
@implements IDisposable

<PageTitle>Feedback - Kechap</PageTitle>

<div class="mx-auto my-6 max-w-[700px] px-4 pb-12">
    <h1 class="mb-6 font-display text-3xl font-bold">Rate &amp; Review Kechap</h1>

    @* ---------- Leave feedback ---------- *@
    <section class="mb-6 rounded-2xl border border-line bg-card p-8 shadow-lg transition-colors duration-300">
        <h2 class="mb-4 font-display text-xl font-semibold">Leave Your Feedback</h2>

        <EditForm EditContext="editContext" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <label class="mb-2 block text-sm font-medium">Select Star Rating</label>
            <div class="mb-1 flex gap-1" role="radiogroup" aria-label="Star rating" @onmouseleave="() => hoverRating = 0">
                @for (var star = 1; star <= 5; star++)
                {
                    var value = star;
                    <button type="button" role="radio" aria-checked="@(form.Rating == value ? "true" : "false")"
                            aria-label="@value @(value == 1 ? "star" : "stars")" title="@value @(value == 1 ? "star" : "stars")"
                            @onclick="() => SetRating(value)"
                            @onmouseenter="() => hoverRating = value"
                            class="cursor-pointer text-[2rem] leading-none transition-all duration-150 hover:scale-110 @(value <= ShownRating ? "text-amber-400" : "text-ink/25")">
                        ★
                    </button>
                }
            </div>
            <div class="mb-5 min-h-5 text-sm font-medium text-red-200 dark:text-red-300">
                <ValidationMessage For="() => form.Rating" />
            </div>

            <InputText @bind-Value="form.Name" maxlength="@FeedbackService.MaxNameLength"
                       placeholder="Your Name" class="@FieldClass" />
            <div class="mb-5 min-h-5 text-sm font-medium text-red-200 dark:text-red-300">
                <ValidationMessage For="() => form.Name" />
            </div>

            <textarea @bind="form.Comment" @bind:event="oninput" @bind:after="OnCommentChanged"
                      maxlength="@FeedbackService.MaxCommentLength" rows="4"
                      placeholder="Write your comment or suggestions here..."
                      class="@(FieldClass + " resize-y")"></textarea>
            <div class="mb-5 flex justify-between gap-4 text-sm font-medium">
                <span class="text-red-200 dark:text-red-300"><ValidationMessage For="() => form.Comment" /></span>
                <span class="shrink-0 opacity-70">@form.Comment.Length / @FeedbackService.MaxCommentLength</span>
            </div>

            <div class="flex items-center gap-4">
                <button type="submit"
                        class="cursor-pointer rounded-lg bg-btn px-10 py-2.5 font-semibold text-btn-ink shadow-md transition hover:opacity-90">
                    Post Feedback
                </button>
                @if (showThanks)
                {
                    <span class="text-sm font-medium">✔ Thanks for your feedback!</span>
                }
                @if (saveError is not null)
                {
                    <span class="text-sm font-medium text-red-200 dark:text-red-300">@saveError</span>
                }
            </div>
        </EditForm>
    </section>

    @* ---------- Community comments ---------- *@
    <section class="rounded-2xl border border-line bg-card p-8 shadow-lg transition-colors duration-300">
        <h2 class="mb-4 font-display text-xl font-semibold">Community Comments</h2>

        @if (entries.Count == 0)
        {
            <p class="text-sm opacity-80">No comments yet. Be the first to leave one!</p>
        }

        @foreach (var entry in entries)
        {
            <article @key="entry.Id" class="mb-4 rounded-[10px] border border-line bg-black/[0.03] px-5 py-4 last:mb-0">
                <div class="mb-1 font-semibold">@entry.Name</div>
                <div class="mb-2 text-[0.9rem] tracking-wide text-amber-400" aria-label="@entry.Rating out of 5 stars">@StarText(entry.Rating)</div>
                <p class="text-[0.9rem] break-words whitespace-pre-line opacity-90">@entry.Comment</p>
            </article>
        }
    </section>
</div>

@code {
    private const string FieldClass = "w-full rounded-[10px] border border-line bg-field px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink/50 focus:border-accent focus:ring-[3px] focus:ring-accent/15 focus:outline-none";

    private readonly FeedbackForm form = new();
    private EditContext editContext = default!;
    private FieldIdentifier ratingField;
    private FieldIdentifier commentField;

    private IReadOnlyList<FeedbackEntry> entries = Array.Empty<FeedbackEntry>();
    private int hoverRating;
    private bool showThanks;
    private string? saveError;
    private bool disposed;

    // While hovering, preview the hovered star; otherwise show the chosen rating.
    private int ShownRating => hoverRating > 0 ? hoverRating : form.Rating;

    protected override void OnInitialized()
    {
        editContext = new EditContext(form);
        ratingField = editContext.Field(nameof(FeedbackForm.Rating));
        commentField = editContext.Field(nameof(FeedbackForm.Comment));

        entries = FeedbackStore.GetAll();
        FeedbackStore.Changed += OnFeedbackChanged;
    }

    // Someone posted (maybe in another browser tab): refresh this list too.
    private void OnFeedbackChanged() => InvokeAsync(() =>
    {
        if (disposed) return;
        entries = FeedbackStore.GetAll();
        StateHasChanged();
    });

    private void SetRating(int value)
    {
        form.Rating = value;
        editContext.NotifyFieldChanged(ratingField);   // clears the "pick a star rating" message
    }

    private void OnCommentChanged() => editContext.NotifyFieldChanged(commentField);

    private async Task SubmitAsync()
    {
        saveError = null;

        try
        {
            FeedbackStore.Add(form.Name, form.Rating, form.Comment);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            saveError = "Sorry, your comment could not be saved. Please try again.";
            return;
        }

        // Clear the form in place (the same model object keeps the form working).
        form.Rating = 0;
        form.Name = "";
        form.Comment = "";
        hoverRating = 0;
        editContext.MarkAsUnmodified();

        // Show the new comment in Community Comments right away.
        entries = FeedbackStore.GetAll();

        showThanks = true;
        StateHasChanged();
        await Task.Delay(3000);
        showThanks = false;
    }

    private static string StarText(int rating)
        => new string('★', Math.Clamp(rating, 0, 5)) + new string('☆', 5 - Math.Clamp(rating, 0, 5));

    public void Dispose()
    {
        disposed = true;
        FeedbackStore.Changed -= OnFeedbackChanged;
    }

    private sealed class FeedbackForm
    {
        [Range(1, 5, ErrorMessage = "Please pick a star rating.")]
        public int Rating { get; set; }

        [Required(ErrorMessage = "Please enter your name.")]
        [StringLength(FeedbackService.MaxNameLength, ErrorMessage = "Name is too long.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Please write a comment.")]
        [StringLength(FeedbackService.MaxCommentLength, ErrorMessage = "Comment is too long.")]
        public string Comment { get; set; } = "";
    }
}