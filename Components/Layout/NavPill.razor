<NavLink href="@Href" Match="@Match"
         class="group flex items-center gap-2 rounded-full px-3.5 py-2 text-sm font-semibold whitespace-nowrap text-accent transition-all duration-200 hover:bg-active [&.active]:bg-active">
    <svg viewBox="0 0 24 24" class="size-[18px] fill-none stroke-current stroke-2" aria-hidden="true">
        @Icon
    </svg>
    <span class="max-w-0 overflow-hidden opacity-0 transition-all duration-300 group-hover:max-w-[100px] group-hover:opacity-100 group-[.active]:max-w-[100px] group-[.active]:opacity-100">
        @Label
    </span>
</NavLink>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
    [Parameter, EditorRequired] public RenderFragment Icon { get; set; } = default!;
}